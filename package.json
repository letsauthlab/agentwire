{
  "name": "agentwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:data && astro build",
    "preview": "astro preview",
    "validate:data": "tsx scripts/validate-data.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm validate:data && pnpm lint && pnpm typecheck && pnpm test && astro build && pnpm check:budgets",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "check:tokens": "tsx scripts/check-tokens.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "^7.3.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
}
