---
import Base from "@/layouts/Base.astro";
import { SITE_NAME } from "@/lib/site";
---

<Base
  title={SITE_NAME}
  description="A news wire for agentic identity, security and platforms: announcements, drafts, releases, papers and incident reports, each with a short summary and a link to the source."
  path="/"
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">In preparation</p>
      <h1>News on agentic identity, security and platforms</h1>
      <p class="lede">
        Agentwire will collect announcements, drafts, releases, papers and incident reports from
        standards bodies, vendors, research labs and open source projects. Each story will show a
        short summary, a link to the source and the reactions to it.
      </p>
    </header>
    <p>The site is being built. Nothing is published here yet.</p>
  </div>
</Base>
